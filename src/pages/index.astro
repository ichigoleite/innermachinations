---
import { getCollection } from "astro:content";
import Main from "../layouts/main.astro";
import "../styles/pages/index.css";

const questions = await getCollection("questions");

questions.sort((a, b) => {
  // parse time from id
  const adate = new Date();

  adate.setUTCFullYear(
    Number(a.id.slice(0, 4)),
    Number(a.id.slice(4, 6)) - 1,
    Number(a.id.slice(6, 8)),
  );
  adate.setUTCHours(
    Number(a.id.slice(8, 10)),
    Number(a.id.slice(10, 12)),
    Number(a.id.slice(12, 14)),
    0,
  );

  const bdate = new Date();

  bdate.setUTCFullYear(
    Number(b.id.slice(0, 4)),
    Number(b.id.slice(4, 6)) - 1,
    Number(b.id.slice(6, 8)),
  );
  bdate.setUTCHours(
    Number(b.id.slice(8, 10)),
    Number(b.id.slice(10, 12)),
    Number(b.id.slice(12, 14)),
    0,
  );
  if (bdate >= adate) {
    return 1;
  } else {
    return -1;
  }
});
---

<Main>
  <h1>Welcome!</h1>
  <p>This is a compilation of Miitomo questions that I've answered.</p>
  <p>Enjoy at your own pace or something.</p>
  <p>
    (Some of these answers may contain opinions you may disagree with. While you
    can disagree, please communicate in a respectful manner.)
  </p>
  <section id="innermachinations-questions">
    {
      questions.map((item) => (
        <a href={`/questions/${item.id}`}>
          <img
            class="innermachinations-questions-question-image"
            src={item.data.data}
            width="1280"
            alt="Question"
          />
        </a>
      ))
    }
  </section>
</Main>
