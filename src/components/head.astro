---
import { Head } from "astro-capo";
const { title, description, image } = Astro.props;
---

<Head>
  <meta charset="utf-8" />
  <title>{title ?? "the inner machinations of ichigoleite"}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="author" content="ichigoleite" />
  <meta
    name="description"
    content={description ??
      "a compilation of miitomo questions (no i don't plan to do harm the title is misleading it is just a dumb reference)"}
  />
  <meta
    property="og:image"
    content={image ?? "https://mtquestions.ichigoleite.com/bg.png"}
  />
  <meta
    property="og:description"
    content={description ??
      "a compilation of miitomo questions (no i don't plan to do harm the title is misleading it is just a dumb reference)"}
  />
  <meta
    property="og:title"
    content={title ?? "the inner machinations of ichigoleite"}
  />
  <meta
    property="og:site_name"
    content="the inner machinations of ichigoleite"
  />
  <link
    rel="icon"
    type="image/png"
    href="/favicon/favicon-96x96.png"
    sizes="96x96"
  />
  <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
  <link rel="shortcut icon" href="/favicon/favicon.ico" />
  <link
    rel="apple-touch-icon"
    sizes="180x180"
    href="/favicon/apple-touch-icon.png"
  />
  <meta name="apple-mobile-web-app-title" content="run" />
  <link rel="manifest" href="/favicon/site.webmanifest" />
</Head>
